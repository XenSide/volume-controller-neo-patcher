{
	"Name": "Volume Controller NEO",
	"Version": "2.0.4.208",
	"Author": "xenside",
	"Description": "Elgato's Volume Controller with Stream Deck Neo support and redesigned keys, built locally from your own copy of the official plugin. Uses Elgato's Audio Router (ws://127.0.0.1:1844), installed with the official Volume Controller.",
	"Category": "Volume Controller NEO",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://www.elgato.com",
	"SDKVersion": 2,
	"CodePath": "bin/plugin.js",
	"Nodejs": {
		"Version": "20",
		"Debug": "disabled"
	},
	"Software": {
		"MinimumVersion": "6.5"
	},
	"OS": [
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"UUID": "com.xenside.volumecontroller",
	"ApplicationsToMonitor": {
		"windows": [
			"ElgatoAudioControlServer.exe"
		]
	},
	"Actions": [
		{
			"UUID": "com.xenside.volumecontroller.auto-detection",
			"Name": "Auto Software Detection",
			"Tooltip": "Automatically configure audio control for open applications.",
			"Icon": "imgs/actions/auto-detection/action",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/auto-detection/key"
				}
			],
			"PropertyInspectorPath": "pi/application/auto-detection/inspector.html",
			"SupportedInMultiActions": false
		},
		{
			"UUID": "com.xenside.volumecontroller.manual-detection",
			"Name": "Manual Software Detection",
			"Tooltip": "Manually configure audio control for open applications.",
			"Icon": "imgs/actions/manual-detection/action",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/manual-detection/key"
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust",
					"Push": "Mute/unmute"
				}
			},
			"PropertyInspectorPath": "pi/application/manual-detection/inspector.html"
		},
		{
			"UUID": "com.xenside.volumecontroller.output-device-control",
			"Name": "Output Device Control",
			"Tooltip": "Configure audio control for connected output devices.",
			"Icon": "imgs/actions/output-device-control/action",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/output-device-control/key"
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust",
					"Push": "Mute/unmute"
				}
			},
			"PropertyInspectorPath": "pi/device/output-device-control/inspector.html"
		},
		{
			"UUID": "com.xenside.volumecontroller.input-device-control",
			"Name": "Input Device Control",
			"Tooltip": "Configure audio control for connected input devices.",
			"Icon": "imgs/actions/input-device-control/action",
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/input-device-control/key"
				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust",
					"Push": "Mute/unmute"
				}
			},
			"PropertyInspectorPath": "pi/device/input-device-control/inspector.html"
		},
		{
			"UUID": "com.xenside.volumecontroller.back-to-profile",
			"Name": "Back To Profile",
			"Icon": "imgs/actions/auto-back-to-profile/category",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/auto-back-to-profile/action"
				}
			],
			"SupportedInMultiActions": false
		},
		{
			"UUID": "com.xenside.volumecontroller.auto-detection.mute",
