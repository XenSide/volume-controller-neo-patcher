				}
			],
			"Encoder": {
				"layout": "$B1",
				"TriggerDescription": {
					"Rotate": "Adjust",
					"Push": "Mute/unmute"
				}
			},
			"SupportedInMultiActions": false
		},
		{
			"UUID": "com.xenside.volumecontroller.auto-detection.blank",
			"Name": "Blank",
