+// --- Volume Controller NEO: manual-key graphics, "Duotone Essentials" style ----------
+// Flat full-bleed tile, two tones of one hue, no black/white/gradients (matches the icon pack).
+const neoThemes = {
+  blue: { bg: "#3b4c66", sec: "#4c70a3", pri: "#67a4ff" },
+  purple: { bg: "#4e3d66", sec: "#774ea3", pri: "#b367ff" },
+  orange: { bg: "#6a5542", sec: "#a67b50", pri: "#ffb367" },
+  red: { bg: "#623d46", sec: "#a14e5d", pri: "#ff6783" }
+};
+const neoTheme = app => app?.mute ? neoThemes.red : neoThemes.blue;
+const neoEsc = s => String(s ?? "").replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);
+const neoFont = 'font-family="Segoe UI, Arial, sans-serif" font-weight="700"';
+// app icon in the theme's two tones, or a duotone speaker while it is not ready / missing
+function neoIconSvg(app, th, x, y, s) {
+  const u = neoDuoIcon(app, th);
+  if (u) return `<image x="${x}" y="${y}" width="${s}" height="${s}" xlink:href="${u}" href="${u}"/>`;
+  const k = s / 100;
+  return `<g transform="translate(${x} ${y}) scale(${k})"><path d="M18 38 h16 l22 -18 v60 l-22 -18 h-16 a6 6 0 0 1 -6 -6 v-12 a6 6 0 0 1 6 -6 z" fill="${th.pri}"/>` +
+    `<path d="M66 36 a20 20 0 0 1 0 28 M76 26 a34 34 0 0 1 0 48" fill="none" stroke="${th.sec}" stroke-width="8" stroke-linecap="round"/></g>`;
+}
+const neoSlash = (th, cx, cy, r) => `<path d="M${cx - r} ${cy - r} L${cx + r} ${cy + r}" stroke="${th.bg}" stroke-width="16" stroke-linecap="round"/><path d="M${cx - r} ${cy - r} L${cx + r} ${cy + r}" stroke="${th.pri}" stroke-width="8" stroke-linecap="round"/>`;
